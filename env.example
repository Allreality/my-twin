# my-twin Digital Twin Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# API Keys
# =============================================================================

# Anthropic Claude API Key (required for Claude integration)
ANTHROPIC_API_KEY=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

# OpenAI API Key (optional - if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Digital Twin Configuration
# =============================================================================

# Twin Identity
TWIN_NAME=Akil
TWIN_PERSONALITY=my_PERSONALITY.txt

# Feature Toggles
ENABLE_MEMORY=true
ENABLE_EMOTIONAL_STATE=true
ENABLE_CONTEXT_AWARENESS=true

# =============================================================================
# Memory System Settings
# =============================================================================

# Semantic Memory (Long-term storage)
SEMANTIC_MEMORY_LIMIT=1000
SEMANTIC_MEMORY_RETENTION_DAYS=365

# Working Memory (Short-term context)
WORKING_MEMORY_LIMIT=50
WORKING_MEMORY_TIMEOUT_MINUTES=30

# Emotional State
EMOTIONAL_STATE_DECAY=0.95
EMOTIONAL_STATE_UPDATE_INTERVAL=5

# =============================================================================
# Knowledge Base Configuration
# =============================================================================

# BlackArt Gallery Integration
ENABLE_BLACKART_KNOWLEDGE=true
BLACKART_GALLERY_URL=https://blackart.vip

# Additional Knowledge Bases (comma-separated)
KNOWLEDGE_BASES=blackart_gallery

# Midnight/Twin Integration
ENABLE_MIDNIGHT_KNOWLEDGE=true
BLACKART_GALLERY_URL=https://midnight-compliance.com

# Additional Knowledge Bases (comma-separated)
KNOWLEDGE_BASES=midnight-knowledgebase

# =============================================================================
# Blockchain Integration (x402)
# =============================================================================

# x402 Wallet System
X402_WALLET_ENABLED=false
X402_NETWORK=testnet
X402_WALLET_ADDRESS=Fe6AiMpMPjqJ5rSpZ6ck4SmQitepuK1koGB64QtGWe7i
X402_PRIVATE_KEY=

# Treasury Configuration
X402_TREASURY_ADDRESS=addr1q9np4m2eg4xtr8kn6mvccwklpv6a7kxhq8uqkk45gpd2tz326xxqn233h4a3lf5yv3utg7lwlg0vheasx9zjvzyfy8kqs0gpcx
X402_AUTO_FORWARD=false

# =============================================================================
# Performance & Optimization
# =============================================================================

# Response Generation
MAX_RESPONSE_LENGTH=500
RESPONSE_TEMPERATURE=0.7
RESPONSE_TOP_P=0.9

# Memory Management
MEMORY_COMPRESSION_ENABLED=true
MEMORY_COMPRESSION_THRESHOLD=0.8

# =============================================================================
# Logging & Debugging
# =============================================================================

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FILE=logs/twin.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Debug Mode
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://your_sentry_dsn_here

# =============================================================================
# External Services (Optional)
# =============================================================================

# Database (if using external storage)
DATABASE_URL=
DATABASE_TYPE=sqlite

# Cache (Redis, Memcached)
CACHE_ENABLED=false
CACHE_URL=redis://localhost:6379/0
# Optional: Redis Cache
# REDIS_URL=redis://localhost:6379

# Metrics (InfluxDB)
INFLUXDB_ENABLED=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# Optional: Database
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=generate_random_secret_key_here

# Port Configuration
PORT=8080

# =============================================================================
# Security
# =============================================================================

# Encryption
ENCRYPT_MEMORY=false
ENCRYPTION_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Development Settings
# =============================================================================

# Blockfrost API Configuration (Midnight)
# Get your key from: https://blockfrost.io/dashboard
BLOCKFROST_PROJECT_ID=mainnetydnqWQUNmhXICaJFWlSHtQEVXt9VrVop
BLOCKFROST_NETWORK=mainnet

# Testing
TEST_MODE=false
TEST_DATA_PATH=tests/data

# Mock Services (for testing without real APIs)
MOCK_ANTHROPIC=false
MOCK_BLOCKCHAIN=false

